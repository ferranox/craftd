set_accessibility() {
    local name="$1" access="$2" props enabled enabled_bool
    props="$(server_dir "$name")/server.properties"
    if [[ "$access" == "private" ]]; then enabled="true"; else enabled="false"; fi
    set_property "$props" white-list "$enabled" "$SERVICE_USER:$SERVICE_GROUP" || return 1
    set_property "$props" enforce-whitelist "$enabled" "$SERVICE_USER:$SERVICE_GROUP" || return 1
    ACCESS="$access"
    write_config "$name" || return 1
    if service_active "$(server_unit "$name")"; then
        if [[ "$enabled" == "true" ]]; then enabled_bool="on"; else enabled_bool="off"; fi
        send_command "$name" "whitelist $enabled_bool" || return 1
        info "Whitelist enabled: $enabled (applied immediately)."
    else
        info "Whitelist enabled: $enabled. It will apply when the server starts."
    fi
}

manage_whitelist() {
    local name="$1" choice username enabled
    while true; do
        printf '\ncraftd - whitelist: %s\n\n' "$name"
        whitelist_list "$name"
        printf '\n1. Add a username\n2. Remove a username\n3. Enable whitelist (private)\n4. Disable whitelist (public)\n0. Back\n\n'
        read -r -p "Select an option: " choice || return 0
        case "$choice" in
            1)
                read -r -p "Minecraft username: " username || continue
                whitelist_add_offline "$name" "$username"
                ;;
            2)
                read -r -p "Minecraft username to remove: " username || continue
                [[ -n "$username" ]] && whitelist_remove_offline "$name" "$username"
                ;;
            3|4)
                if [[ "$choice" == "3" ]]; then enabled="private"; else enabled="public"; fi
                set_accessibility "$name" "$enabled"
                ;;
            0) return 0 ;;
            *) warn "Choose an option from 0 to 4." ;;
        esac
    done
}

offer_restart() {
    local name="$1" immediate="${2:-}"
    if [[ "$immediate" == "immediate" ]]; then
        info "Change applied immediately and saved for future restarts."
    elif service_active "$(server_unit "$name")"; then
        info "This change requires a restart to take full effect."
        if confirm "Restart '$name' now?"; then
            restart_server "$name"
        else
            info "The change was saved and will apply after the next restart."
        fi
    else
        info "Change saved. It will apply when the server starts."
    fi
}

change_port() {
    local name="$1" value
    read -r -p "Server port [$PORT]: " value || return 1
    value="${value:-$PORT}"
    if [[ "$value" == "$PORT" ]]; then
        info "Port unchanged ($PORT)."
        return 0
    fi
    if ! port_available "$value" "$name"; then
        error "Port '$value' is unavailable. Choose an unused port from 1024 to 65535."
        return 1
    fi
    set_property "$(server_dir "$name")/server.properties" server-port "$value" "$SERVICE_USER:$SERVICE_GROUP" || return 1
    PORT="$value"
    write_config "$name" || return 1
    info "Port changed to $PORT."
    offer_restart "$name"
    if [[ "$STARTUP" == "automatic" ]] && ! service_active "$(server_unit "$name")"; then
        systemctl restart "$(listener_unit "$name")" || return 1
        info "The automatic listener now uses port $PORT."
    fi
}

edit_properties() {
    local name="$1" props choice value current bool key immediate=""
    props="$(server_dir "$name")/server.properties"
    while true; do
        printf '\ncraftd - advanced options: %s\n\n' "$name"
        printf 'Gamemode: %s | Difficulty: %s | Max players: %s | PvP: %s | Nether: %s\n' \
            "$(get_property "$props" gamemode || printf '?')" \
            "$(get_property "$props" difficulty || printf '?')" \
            "$(get_property "$props" max-players || printf '?')" \
            "$(get_property "$props" pvp || printf '?')" \
            "$(get_property "$props" allow-nether || printf '?')"
        printf 'View distance: %s | Simulation distance: %s | Online mode: %s\n\n' \
            "$(get_property "$props" view-distance || printf '?')" \
            "$(get_property "$props" simulation-distance || printf '?')" \
            "$(get_property "$props" online-mode || printf '?')"
        cat <<'MENU'
1. Gamemode
2. Difficulty
3. Maximum players
4. PvP
5. Nether
6. View distance
7. Simulation distance
8. Server message
9. Online mode
10. Server port
11. Edit another server.properties setting
0. Back

MENU
        read -r -p "Select an option: " choice || return 0
        immediate=""
        case "$choice" in
            1)
                read -r -p "Gamemode [survival/creative/adventure/spectator]: " value || continue
                value="${value,,}"
                [[ "$value" =~ ^(survival|creative|adventure|spectator)$ ]] || { warn "Invalid gamemode."; continue; }
                key="gamemode"
                ;;
            2)
                read -r -p "Difficulty [peaceful/easy/normal/hard]: " value || continue
                value="${value,,}"
                [[ "$value" =~ ^(peaceful|easy|normal|hard)$ ]] || { warn "Invalid difficulty."; continue; }
                key="difficulty"
                immediate="immediate"
                ;;
            3)
                read -r -p "Maximum players [20]: " value || continue
                value="${value:-20}"
                [[ "$value" =~ ^[0-9]+$ && "$value" -ge 1 && "$value" -le 2147483647 ]] || { warn "Enter a positive number."; continue; }
                key="max-players"
                ;;
            4|5)
                current="true"; [[ "$choice" == "5" ]] && current="$(get_property "$props" allow-nether || printf 'true')"
                if [[ "$choice" == "4" ]]; then
                    ask_yes_no "Enable PvP? [Y/n]: " "y" && bool=true || bool=false
                    key="pvp"
                else
                    ask_yes_no "Enable the Nether? [Y/n]: " "y" && bool=true || bool=false
                    key="allow-nether"
                fi
                value="$bool"
                ;;
            6)
                read -r -p "View distance [10]: " value || continue
                value="${value:-10}"
                [[ "$value" =~ ^[0-9]+$ && "$value" -ge 3 && "$value" -le 32 ]] || { warn "Choose a value from 3 to 32."; continue; }
                key="view-distance"
                ;;
            7)
                read -r -p "Simulation distance [10]: " value || continue
                value="${value:-10}"
                [[ "$value" =~ ^[0-9]+$ && "$value" -ge 3 && "$value" -le 32 ]] || { warn "Choose a value from 3 to 32."; continue; }
                key="simulation-distance"
                ;;
            8)
                read -r -p "Server message: " value || continue
                [[ -n "$value" && "$value" != *$'\n'* ]] || { warn "The server message cannot be empty."; continue; }
                key="motd"
                ;;
            9)
                info "Online mode verifies Minecraft accounts with Microsoft. Keep it enabled unless you understand the security risks."
                warn "Changing online mode changes player UUIDs and may invalidate the existing whitelist and player data. Re-add players after the restart."
                ask_yes_no "Enable online mode? [Y/n]: " "y" && bool=true || bool=false
                value="$bool"
                key="online-mode"
                ;;
            10)
                change_port "$name"
                continue
                ;;
            11)
                read -r -p "Property name: " key || continue
                [[ "$key" =~ ^[A-Za-z0-9_.-]+$ ]] || { warn "Invalid property name."; continue; }
                [[ "$key" != "server-port" ]] || { warn "Use option 10 to change the port safely."; continue; }
                [[ "$key" != "white-list" && "$key" != "enforce-whitelist" ]] || { warn "Use the whitelist menu to change accessibility safely."; continue; }
                current="$(get_property "$props" "$key" || true)"
                read -r -p "Value for $key${current:+ [$current]}: " value || continue
                value="${value:-$current}"
                [[ "$value" != *$'\n'* ]] || { warn "Values must be one line."; continue; }
                [[ "$key" == "level-seed" || "$key" == "level-type" || "$key" == "level-name" ]] && info "World-generation settings only affect a new world; your existing world is not regenerated."
                ;;
            0) return 0 ;;
            *) warn "Choose an option from 0 to 11."; continue ;;
        esac
        set_property "$props" "$key" "$value" "$SERVICE_USER:$SERVICE_GROUP" || continue
        info "Set $key=$value"
        if [[ "$key" == "difficulty" ]] && service_active "$(server_unit "$name")"; then
            send_command "$name" "difficulty $value" && offer_restart "$name" "immediate"
        else
            offer_restart "$name"
        fi
    done
}

restore_version_state() {
    local name="$1" was_running="$2" was_waiting="$3"
    rm -f -- "$CONFIG_DIR/$name.update"
    if ((was_running)); then
        start_server "$name"
    elif ((was_waiting)); then
        systemctl start "$(listener_unit "$name")"
    fi
}

change_version() {
    local name="$1" was_running=0 was_waiting=0 old_version new_java
    load_config "$name"
    old_version="$VERSION"
    service_active "$(server_unit "$name")" && was_running=1
    if ((!was_running)) && service_active "$(listener_unit "$name")"; then was_waiting=1; fi
    info "Current Minecraft version: $old_version"
    choose_version || return 1
    if [[ "$SELECTED_VERSION" == "$old_version" ]]; then
        info "The latest stable Paper build for $old_version will be installed."
    fi
    warn "Changing Minecraft versions can make a world incompatible with older versions. Plugins may also need updates."
    confirm "Change '$name' from $old_version to $SELECTED_VERSION?" || { info "Version unchanged."; return 0; }
    # This root-owned marker prevents automatic wake-ups throughout the version swap.
    : >"$CONFIG_DIR/$name.update" || return 1
    if ! systemctl stop "$(listener_unit "$name")"; then
        restore_version_state "$name" "$was_running" "$was_waiting"
        return 1
    fi
    if ((was_running)) && ! systemctl stop "$(server_unit "$name")"; then
        error "Could not stop '$name'; version unchanged."
        restore_version_state "$name" "$was_running" "$was_waiting"
        return 1
    fi
    systemctl stop "$(listener_unit "$name")" >/dev/null 2>&1 || true
    if ! ensure_java "$SELECTED_JAVA"; then
        restore_version_state "$name" "$was_running" "$was_waiting"
        return 1
    fi
    new_java="$FOUND_JAVA"
    if ! download_paper "$name" "$SELECTED_VERSION"; then
        restore_version_state "$name" "$was_running" "$was_waiting"
        return 1
    fi
    VERSION="$SELECTED_VERSION"
    BUILD="$DOWNLOAD_BUILD"
    JAVA="$new_java"
    JAVA_MIN="$SELECTED_JAVA"
    if ! write_config "$name"; then
        restore_version_state "$name" "$was_running" "$was_waiting"
        return 1
    fi
    rm -f -- "$CONFIG_DIR/$name.update"
    info "Minecraft version changed to $VERSION. World, plugins, logs and configuration were preserved."
    if ((was_running)) || [[ "$STARTUP" == "always" ]]; then
        start_server "$name"
    elif ((was_waiting)); then
        systemctl start "$(listener_unit "$name")"
    fi
}

change_startup() {
    local name="$1" choice
    printf '\nStartup behaviour\n\n1. Manual - only start when requested\n2. Always on - start at boot and keep running\n3. Automatic - wake when someone tries to join\n0. Back\n\n'
    read -r -p "Select an option [1-3]: " choice || return 0
    case "$choice" in
        1) STARTUP="manual" ;;
        2) STARTUP="always" ;;
        3) STARTUP="automatic" ;;
        0|"") return 0 ;;
        *) warn "Choose 1, 2 or 3."; return 1 ;;
    esac
    write_config "$name" || return 1
    apply_startup "$name"
}

view_logs() {
    local name="$1" log
    validate_name "$name"
    server_exists "$name" || die "Server '$name' does not exist."
    log="$(server_dir "$name")/logs/latest.log"
    if [[ ! -x "$(server_dir "$name")" ]]; then
        error "The log is not readable by this user. Run: sudo craftd --logs $name"
        return 1
    fi
    if [[ ! -f "$log" ]]; then
        info "No log has been created yet. Start the server first, or check 'sudo systemctl status craftd@$name'."
        return 0
    fi
    if [[ ! -r "$log" ]]; then
        error "The log is not readable by this user. Run: sudo craftd --logs $name"
        return 1
    fi
    if [[ -t 1 ]] && command -v less >/dev/null 2>&1; then
        less +G "$log"
    else
        tail -n 250 "$log"
    fi
}

view_console() {
    local name="$1" log tail_pid command
    log="$(server_dir "$name")/logs/latest.log"
    service_active "$(server_unit "$name")" || die "Server '$name' is not running."
    [[ "$EUID" -eq 0 ]] || die "Run the live console with sudo so console commands can be sent."
    info "Live console for '$name'. Type Minecraft console commands below."
    info "Press Ctrl+C to stop viewing; this will not stop the server."
    touch "$log" 2>/dev/null || true
    tail -n 30 -F "$log" &
    tail_pid=$!
    trap 'kill "$tail_pid" 2>/dev/null; trap - INT; return 0' INT
    while IFS= read -r -p "> " command; do
        [[ -n "$command" ]] && send_command "$name" "$command"
        service_active "$(server_unit "$name")" || break
    done
    kill "$tail_pid" 2>/dev/null
    trap - INT
}

delete_server() {
    local name="$1" dir
    require_root --delete "$name"
    require_systemd
    acquire_config_lock
    load_config "$name"
    dir="$(server_dir "$name")"
    warn "This permanently deletes '$name' (Minecraft $VERSION), including its worlds, plugins, configuration and logs."
    confirm "Delete server '$name' permanently?" || { info "Server '$name' was not deleted."; return 1; }
    systemctl disable --now "$(listener_unit "$name")" >/dev/null 2>&1 || { error "Could not stop the listener. No server data was deleted."; return 1; }
    STARTUP="manual"
    write_config "$name" || return 1
    systemctl stop "$(server_unit "$name")" || { error "Could not stop '$name'. No server data was deleted."; return 1; }
    if service_active "$(server_unit "$name")" || service_active "$(listener_unit "$name")"; then
        error "'$name' is still active. No server data was deleted."
        return 1
    fi
    systemctl disable "$(server_unit "$name")" >/dev/null 2>&1 || { error "Could not disable '$name'. No server data was deleted."; return 1; }
    rm -rf -- "$dir" || return 1
    rm -f -- "$(config_file "$name")" || return 1
    systemctl reset-failed "$(server_unit "$name")" "$(listener_unit "$name")" >/dev/null 2>&1 || true
    info "Server '$name' deleted."
}

create_server() {
    local name version java_min ram_default ram port choice gamemode difficulty access startup username dir props address
    require_root --create
    require_deps
    require_systemd
    acquire_config_lock
    [[ -f /etc/systemd/system/craftd@.service ]] || die "craftd system services are not installed. Run the craftd installer first."
    install -d -m 0755 "$SERVERS_DIR" "$CONFIG_DIR"
    printf '\ncraftd - create a Paper server\n\n'
    info "Press Enter to accept each displayed default."
    while true; do
        read -r -p "Server name: " name || return 1
        name="${name,,}"
        if ! valid_name "$name"; then
            warn "Use 1-32 lowercase letters, numbers, '-' or '_', starting with a letter or number."
        elif [[ -e "$(config_file "$name")" || -e "$(server_dir "$name")" ]]; then
            warn "A server named '$name' already exists."
        else
            break
        fi
    done
    choose_version || return 1
    version="$SELECTED_VERSION"
    java_min="$SELECTED_JAVA"
    choose_from_menu "Gamemode" 1 "Survival" "Creative" "Adventure" "Spectator" || return 1
    case "$SELECTED_OPTION" in
        1) gamemode="survival" ;;
        2) gamemode="creative" ;;
        3) gamemode="adventure" ;;
        4) gamemode="spectator" ;;
    esac
    choose_from_menu "Difficulty" 3 "Peaceful" "Easy" "Normal" "Hard" || return 1
    case "$SELECTED_OPTION" in
        1) difficulty="peaceful" ;;
        2) difficulty="easy" ;;
        3) difficulty="normal" ;;
        4) difficulty="hard" ;;
    esac
    choose_from_menu "Accessibility" 1 \
        "Private - only players on the whitelist can join" \
        "Public - anyone with the server address can join" || return 1
    if [[ "$SELECTED_OPTION" == "1" ]]; then access="private"; else access="public"; fi
    choose_from_menu "Startup behaviour" 1 \
        "Automatic - start when someone tries to join (recommended)" \
        "Manual - only start when you ask" \
        "Always on - start at boot and keep running" || return 1
    case "$SELECTED_OPTION" in
        1) startup="automatic" ;;
        2) startup="manual" ;;
        3) startup="always" ;;
    esac
    port="$(next_port)" || { error "No free server port could be found."; return 1; }
    while true; do
        read -r -p "Server port [$port]: " choice || return 1
        choice="${choice:-$port}"
        if port_available "$choice"; then port="$choice"; break; fi
        warn "Choose an unused port from 1024 to 65535."
    done
    ram_default="$(default_memory)"
    while true; do
        read -r -p "Maximum RAM in MB [$ram_default]: " ram || return 1
        ram="${ram:-$ram_default}"
        [[ "$ram" =~ ^[0-9]+$ && "$ram" -ge 512 && "$ram" -le 1048576 ]] && break
        warn "Enter a memory size of at least 512 MB."
    done
    username=""
    if [[ "$access" == "private" ]]; then
        read -r -p "Your Minecraft username for the whitelist (blank to add later): " username || return 1
        if [[ -n "$username" && ! "$username" =~ ^[A-Za-z0-9_]{3,16}$ ]]; then
            warn "Invalid username. You can add one later from 'sudo craftd --manage $name'."
            username=""
        fi
    fi
    printf '\nCreating %s: Minecraft %s on port %s with %s MB RAM.\n' "$name" "$version" "$port" "$ram"
    info "Running a Minecraft server requires acceptance of the Minecraft EULA: https://aka.ms/MinecraftEULA"
    confirm "Do you accept the Minecraft EULA?" || { info "No files were created."; return 1; }
    ensure_java "$java_min" || return 1
    dir="$(server_dir "$name")"
    if ! install -d -m 0750 -o "$SERVICE_USER" -g "$SERVICE_GROUP" "$dir" "$dir/plugins" "$dir/logs"; then
        rm -rf -- "$dir"
        error "Could not create the server directory."
        return 1
    fi
    if ! download_paper "$name" "$version"; then
        rm -rf -- "$dir"
        return 1
    fi
    props="$dir/server.properties"
    cat >"$props" <<PROPERTIES
#Minecraft server properties
#Created by craftd
allow-nether=true
difficulty=$difficulty
enable-command-block=false
enforce-whitelist=$([[ "$access" == "private" ]] && printf true || printf false)
gamemode=$gamemode
generate-structures=true
hardcore=false
level-name=world
level-seed=
max-players=20
motd=$name - PaperMC
online-mode=true
pvp=true
server-ip=
server-port=$port
simulation-distance=10
spawn-protection=16
view-distance=10
white-list=$([[ "$access" == "private" ]] && printf true || printf false)
PROPERTIES
    printf 'eula=true\n' >"$dir/eula.txt"
    chown -R "$SERVICE_USER:$SERVICE_GROUP" "$dir"
    chmod 0644 "$props" "$dir/eula.txt"
    NAME="$name" VERSION="$version" BUILD="$DOWNLOAD_BUILD" PORT="$port" MEMORY="$ram" STARTUP="$startup" ACCESS="$access" JAVA="$FOUND_JAVA" JAVA_MIN="$java_min"
    if ! write_config "$name"; then
        rm -rf -- "$dir"
        error "Could not save the server configuration."
        return 1
    fi
    if [[ -n "$username" ]]; then
        whitelist_add_offline "$name" "$username" || warn "The server was created, but '$username' could not be added. Add it from 'sudo craftd --manage $name'."
    fi
    apply_startup "$name" || return 1
    address="$(primary_ipv4)"
    printf '\nServer '\''%s'\'' is ready.\n\n' "$name"
    info "Address: $address:$PORT"
    if [[ "$address" == "127.0.0.1" ]]; then
        warn "No network address was detected, so players can only connect from this machine."
    else
        info "Players on the same network can connect with this address."
        info "Players outside your network need TCP port $PORT forwarded and allowed through the firewall."
    fi
    case "$startup" in
        manual) info "Start it with: sudo craftd --start $name" ;;
        automatic) info "The server starts automatically when someone connects to that address." ;;
    esac
    info "To manage the server and advanced options, run: sudo craftd --manage $name"
}

print_summary() {
    local show_status="${1:-status}" name status
    local names=()
    mapfile -t names < <(list_server_names)
    if ((${#names[@]} == 0)); then
        info "No servers configured. Create one with: sudo craftd --create"
        return 0
    fi
    printf '%-20s %-9s %-12s %-7s %-9s %-10s\n' "SERVER" "STATUS" "VERSION" "PORT" "ACCESS" "STARTUP"
    for name in "${names[@]}"; do
        load_config "$name"
        if [[ "$show_status" == "status" ]]; then status="$(service_status "$name")"; else status="-"; fi
        printf '%-20s %-9s %-12s %-7s %-9s %-10s\n' "$NAME" "$status" "$VERSION" "$PORT" "${ACCESS^^}" "${STARTUP^^}"
    done
    info ""
    info "STATUS: RUNNING = server active; WAITING = automatic listener active; STOPPED = inactive; FAILED = inspect logs."
}

manage_server() {
    local name="$1" choice
    require_root --manage "$name"
    require_systemd
    load_config "$name"
    while true; do
        load_config "$name"
        printf '\ncraftd - manage: %s\n\n' "$name"
        printf 'Server status: %s\n' "$(service_status "$name")"
        printf 'Minecraft version: %s\n' "$VERSION"
        printf 'Gamemode: %s\n' "$(get_property "$(server_dir "$name")/server.properties" gamemode || printf 'unknown')"
        printf 'Address: %s:%s\n' "$(primary_ipv4)" "$PORT"
        printf 'Accessibility: %s\n\n' "${ACCESS^^}"
        cat <<'MENU'
1. Start server
2. Stop server
3. Restart server
4. View live console
5. View logs
6. Manage whitelist
7. Advanced options
8. Change server version
9. Change startup behaviour
10. Delete server
0. Exit

MENU
        read -r -p "Select an option: " choice || return 0
        case "$choice" in
            1) start_server "$name" ;;
            2) stop_server "$name" ;;
            3) restart_server "$name" ;;
            4) view_console "$name" ;;
            5) view_logs "$name" ;;
            6) manage_whitelist "$name" ;;
            7) edit_properties "$name" ;;
            8) change_version "$name" ;;
            9) change_startup "$name" ;;
            10) delete_server "$name" && return 0 ;;
            0|"") return 0 ;;
            *) warn "Choose an option from 0 to 10." ;;
        esac
    done
}

uninstall() {
    local name created_user=0 primary_group choice
    local names=()
    require_root --uninstall
    acquire_config_lock
    printf '\ncraftd - uninstall\n\n'
    warn "This will permanently remove:"
    info "  * Every craftd Minecraft server, world, plugin, configuration and log in $DATA_DIR"
    info "  * All craftd systemd services and the automatic connection listeners"
    info "  * /usr/local/bin/craftd"
    info "  * The dedicated 'craftd' system account, if it was created by the installer"
    info ""
    read -r -p "Type 'uninstall' to permanently delete all craftd data: " choice || { info "Uninstall cancelled."; return 1; }
    [[ "$choice" == "uninstall" ]] || { info "Uninstall cancelled. No data was removed."; return 1; }
    [[ -f "$DATA_DIR/.user-created" ]] && created_user=1
    mapfile -t names < <(list_server_names)
    for name in "${names[@]}"; do
        info "Stopping and disabling '$name'..."
        systemctl disable --now "$(listener_unit "$name")" >/dev/null 2>&1 || { error "Could not stop the listener for '$name'. No data was removed."; return 1; }
        load_config "$name"
        STARTUP="manual"
        write_config "$name" || return 1
        systemctl stop "$(server_unit "$name")" || { error "Could not stop '$name'. Uninstall aborted; server data was left in place."; return 1; }
        if service_active "$(server_unit "$name")" || service_active "$(listener_unit "$name")"; then
            error "'$name' did not stop completely. Uninstall aborted; no data was removed."
            return 1
        fi
        systemctl disable "$(server_unit "$name")" >/dev/null 2>&1 || { error "Could not disable '$name'. Uninstall aborted."; return 1; }
    done
    for name in "${names[@]}"; do
        systemctl reset-failed "$(server_unit "$name")" "$(listener_unit "$name")" >/dev/null 2>&1 || true
    done
    rm -f -- /etc/systemd/system/craftd@.service /etc/systemd/system/craftd-listener@.service
    systemctl daemon-reload 2>/dev/null || true
    rm -rf -- "$DATA_DIR" || return 1
    rm -f -- /usr/local/bin/craftd || return 1
    if ((created_user)) && getent passwd craftd >/dev/null; then
        primary_group="$(id -gn craftd 2>/dev/null || true)"
        userdel craftd 2>/dev/null || warn "Could not remove the craftd system account. Remove it manually with 'sudo userdel craftd'."
        if [[ "$primary_group" == "craftd" ]] && getent group craftd >/dev/null; then
            groupdel craftd 2>/dev/null || true
        fi
    elif getent passwd craftd >/dev/null; then
        info "The pre-existing 'craftd' account was left unchanged."
    fi
    info "craftd and all server data were removed."
}

show_help() {
    cat <<'HELP'
craftd - simple PaperMC Minecraft server management

Usage:
  sudo craftd --create                  Create a server interactively
  sudo craftd --manage <server-name>    Open the server management menu
       craftd --list                    List configured servers and status
  sudo craftd --start <server-name>     Start a server
  sudo craftd --stop <server-name>      Stop a server cleanly
  sudo craftd --restart <server-name>   Restart a server
       craftd --status                  Show the status of all servers
  sudo craftd --logs <server-name>      Display the latest server log
  sudo craftd --delete <server-name>    Permanently delete a server after confirmation
  sudo craftd --uninstall               Remove craftd, all servers and all server data
       craftd --help                    Show this help

Server data: /var/lib/craftd/servers
Configuration: /var/lib/craftd/config

Commands that manage or read server data need root; --list, --status and --help
do not. Use sudo as shown above.
Automatic mode listens for Minecraft connections and starts the server on demand;
Always on starts the server at boot and keeps it running.
HELP
}

main() {
    local command="${1:---help}" name="${2:-}"
    case "$command" in
        --help|-h|help) show_help ;;
        --create) [[ $# -eq 1 ]] || die "Usage: sudo craftd --create"; create_server ;;
        --list|--status) [[ $# -eq 1 ]] || die "Usage: craftd $command"; print_summary status ;;
        --manage|--start|--stop|--restart|--delete)
            [[ $# -eq 2 && -n "$name" ]] || die "Usage: sudo craftd $command <server-name>"
            case "$command" in
                --manage) manage_server "$name" ;;
                --start) start_server "$name" ;;
                --stop) stop_server "$name" ;;
                --restart) restart_server "$name" ;;
                --delete) delete_server "$name" ;;
            esac
            ;;
        --logs)
            [[ $# -eq 2 && -n "$name" ]] || die "Usage: sudo craftd --logs <server-name>"
            view_logs "$name"
            ;;
        --uninstall) [[ $# -eq 1 ]] || die "Usage: sudo craftd --uninstall"; uninstall ;;
        --run)
            [[ $# -eq 2 ]] || exit 2
            run_server "$name"
            ;;
        --listen)
            [[ $# -eq 2 ]] || exit 2
            run_listener "$name"
            ;;
        --post-stop)
            [[ $# -eq 2 || $# -eq 3 ]] || exit 2
            resume_listener "$name" "${3:-success}"
            ;;
        *) error "Unknown command: $command"; info "Run 'craftd --help' for available commands."; exit 2 ;;
    esac
}

main "$@"
