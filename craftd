    fi
    chown "$SERVICE_USER:$SERVICE_GROUP" "$staging" 2>/dev/null || true
    chmod 0644 "$staging"
    mv -f -- "$staging" "$dir/whitelist.json"
    if [[ "$result" == "0" ]]; then
        info "'$username' was not on the whitelist."
    else
        info "Removed '$username' from the whitelist."
